+# ----------------------------------------------------------------------------- dense coverage gate
+# What the dense crops actually cover, measured 2026-10-09 against the development table:
+#   FFpp_val 699/700, CDFv2val 450/450, DFEval24val 371/450, CDFv3valG 597/1664,
+#   and NOTHING for DF40train, DFDCPval, DS11val, DS20val, FFIWval -- 2117 of 5814 videos (36.4%).
+# So a dense run cannot be selected on the same pool as a sparse one, and the first version of this
+# gate floored coverage at half the pool and stopped the run. That floor was the wrong instrument.
+# Coverage is not what makes a development macro meaningless; an EMPTY v3.1 TYPE is. The macro is a
+# mean over swap / reenactment / in-the-wild, so if the dense subset wiped out one of the three the
+# remaining average would silently be a different objective wearing the same name. It does not:
+# every type keeps at least one scorable cell (swap 2/5, reenactment 1/3, in_the_wild 1/2).
+# This gate therefore checks the thing that matters -- all three types still scorable, on a subset
+# that is not a remnant -- and records the restriction so the number it produces can never be read
+# as a full-pool v3.1. Only the epoch CHOICE rests on it; the pilot's actual answer is the
+# ordered-vs-shuffled |delta p|, which is computed per video and does not depend on this pool at all.
+DEV_RESTRICTION: dict = {}
+MIN_COVERAGE = 0.30
+
+
+def _audit_module():
+    """The analysis module, imported the way THIS trainer's sys.path exposes it.
+
+    `main` does `import exp1_fusion_audit as A` -- flat, because the caller puts
+    `p_dense_code/tbiom` on sys.path rather than importing `tbiom` as a package. Spelling it
+    `tbiom.exp1_fusion_audit` here cost a 21-minute training epoch: the gate runs at the END of
+    epoch 0, so the ModuleNotFoundError did not surface until the first development evaluation.
+    Both spellings are accepted now, and `preflight` below calls this before training starts so a
+    path problem costs seconds instead of an epoch.
+    """
+    try:
+        import exp1_fusion_audit as _A
+    except ModuleNotFoundError:
+        import tbiom.exp1_fusion_audit as _A
+    return _A
+
+
+def preflight():
+    """Everything the per-epoch selection gate needs, resolved before the first batch."""
+    _audit_module()
+    return True
+
+
+def restrict_to_dense(t, announce: bool = False):
+    _A = _audit_module()
+    cov = float(t.p.notna().mean())
+    sub = t[t.p.notna()].reset_index(drop=True)
+    scorable = {}
+    for typ, ri, fi in _A.cells(sub):
+        ok, tot = scorable.setdefault(typ, [0, 0])
+        scorable[typ] = [ok + int(len(ri) > 0 and len(fi) > 0), tot + 1]
+    empty = sorted(k for k, (ok, _) in scorable.items() if ok == 0)
+    DEV_RESTRICTION.clear()
+    DEV_RESTRICTION.update({
+        "restricted": True, "covered": int(t.p.notna().sum()), "pool": int(len(t)),
+        "coverage": round(cov, 4),
+        "per_source": {str(k): [int(v["n"]), int(v["N"])] for k, v in
+                       t.assign(n=t.p.notna().astype(int), N=1).groupby("source")[["n", "N"]].sum().T.to_dict().items()},
+        "cells_scorable": {k: v for k, v in scorable.items()},
+        "note": "dev v3.1 here is computed on the dense-covered subset only; compare against "
+                "sparse-P restricted to the same videos, never against a full-pool v3.1",
+    })
+    if announce:
+        print(f"  DENSE-RESTRICTED SELECTION: {DEV_RESTRICTION['covered']}/{DEV_RESTRICTION['pool']} "
+              f"development videos have dense crops ({cov:.1%}); the rest are DROPPED.", flush=True)
+        for src, (n, N) in sorted(DEV_RESTRICTION["per_source"].items()):
+            print(f"    {src:<14} {n:>5}/{N:<5} {'' if n else '  (absent -- its cells are gone)'}", flush=True)
+        print("    v3.1 cells surviving: "
+              + "  ".join(f"{k} {ok}/{tot}" for k, (ok, tot) in sorted(scorable.items())), flush=True)
+        print("    dev v3.1 below is a RESTRICTED macro. The valid comparison is dense-P against "
+              "sparse-P on these same videos.", flush=True)
+    assert not empty, (f"v3.1 type(s) {empty} have no scorable cell left after dense restriction; "
+                       f"the development macro would be a different objective under the same name")
+    assert cov >= MIN_COVERAGE, (f"dense coverage {cov:.1%} is below the {MIN_COVERAGE:.0%} floor; "
+                                 f"extract more dense crops or abandon the pilot")
+    return sub
+
