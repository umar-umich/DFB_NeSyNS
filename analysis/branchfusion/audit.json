 "b1": {
  "implementation": "analysis/tbiom/grouped/ops.py:discount",
  "convention": "evidence_scaling",
  "formula": "e'_k = r e_k",
  "belief_discounting_would_be": "b'_k = rho b_k, u' = 1 - rho + rho u; e'_k = rho u e_k / (1 - rho + rho u)",
  "not_equivalent": true,
  "source_excerpt": "def discount(o, r):\n    \"\"\"Evidence scaling e' = r e, applied in the evidence domain, then back to an opinion.\"\"\"\n    if r is None or r == 1.0:\n        return o\n    return opinion_of_evidence(evidence_of(o) * r)\n\n\ndef p_of(o):\n    return np.clip(o[..., 0] + o[..., 2] / 2, 0.0, 1.0)\n\n\n# -------------",
  "previous_gamma_sweep": {
   "1.0": 0.9512601499381423,
   "0.5": 0.951565358393083,
   "0.25": 0.9519849055391891,
   "0.125": 0.952244004627469
  },
  "note": "B1 is the global reliability discount. Its verified implementation scales EVIDENCE. `opinions.discount_belief` provides the other convention so the two can be compared, and `DISCOUNT_DEFAULT` names this one so no caller drifts."
 },
